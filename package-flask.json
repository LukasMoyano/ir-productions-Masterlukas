{
  "name": "ir-productions-nexus-flask",
  "private": true,
  "version": "2.0.0",
  "description": "IR Productions Website - Flask Migration",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/styles.css --watch",
    "build": "npm run build:css",
    "dev": "npm run watch:css &",
    "flask:dev": "flask run --debug",
    "flask:prod": "gunicorn -w 4 -b 0.0.0.0:5000 app:app"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1"
  },
  "author": "IR Productions",
  "license": "MIT"
}
