{
  "$schema": "https://opencode.ai/config.json",
  "model": "meta/muse-spark-1.3-free",
  "permission": {
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "git *": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "node *": "allow",
      "python3 *": "allow",
      "docker *": "allow",
      "gh *": "allow",
      "rm -rf *": "deny",
      "rm -rf / *": "deny",
      "sudo *": "deny"
    },
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "skill": "allow",
    "external_directory": "ask"
  },
  "mcp": {}
}
